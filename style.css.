/* Mobile Responsive */
@media screen and (max-width: 768px) {

    body {
        padding: 10px;
    }

    nav {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    nav a {
        display: block;
        margin: 10px 0;
    }

    .products {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .card {
        width: 100%;
        margin: auto;
    }

    img {
        width: 100%;
        height: auto;
    }

    input,
    textarea,
    select,
    button {
        width: 100%;
        box-sizing: border-box;
    }

    .cart {
        width: 95%;
        margin: auto;
    }

    h1, h2, h3 {
        font-size: 24px;
        text-align: center;
    }

    p {
        text-align: center;
    }
}
nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    padding: 15px;
}

nav a {
    color: white;
    text-decoration: none;
    font-size: 18px;
    padding: 8px 15px;
}

nav a:hover {
    color: #ff69b4;
}
